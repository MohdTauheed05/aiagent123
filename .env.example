# ── Demo Mode ────────────────────────────────────────────────────────────
# When true (default), every agent uses the built-in Demo Provider — no
# API keys needed, output is instant mock content. Set to "false" once
# you've filled in a real AI provider below.
NEXT_PUBLIC_DEMO_MODE=true

# Which real provider to use when Demo Mode is off. One of: openai | anthropic | gemini
# This one IS public (NEXT_PUBLIC_) on purpose — it's just a provider name,
# not a secret, and lib/ai/provider.ts reads it from the browser to decide
# which server route to call.
NEXT_PUBLIC_AI_PROVIDER=openai

# ── AI Providers ─────────────────────────────────────────────────────────
# Real keys. These are read ONLY inside app/api/ai/*/route.ts (server-side
# Next.js route handlers) — never add a NEXT_PUBLIC_ prefix to any of these,
# that would ship your key to every visitor's browser.
#   OPENAI_API_KEY     -> powers OpenAIProvider: chat text + DALL-E images
#                         + TTS audio (Echo's narration/voice department)
#   ANTHROPIC_API_KEY  -> powers AnthropicProvider: chat text only
#   GEMINI_API_KEY     -> powers GeminiProvider: chat text only (for now)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override the exact model/voice each route calls (see
# app/api/ai/text, /image, /audio route.ts files for the defaults).
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
ANTHROPIC_TEXT_MODEL=
GEMINI_TEXT_MODEL=

# No default video provider is wired up yet — Motion (video) will throw a
# clear "not configured" error until you add one. See the comments in
# lib/ai/provider.ts for the recommended pattern (a new app/api/ai/video
# route, same shape as the text/image/audio ones).

# ── Firebase ─────────────────────────────────────────────────────────────
# Optional in development. Leave all of these blank to run entirely on the
# local in-memory store (no auth, no Firestore, no Storage). Fill them in
# to enable real-time sync, persistence, and Google/email login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
